@model MiPokemonApp.Models.ViewModels.PokemonFilterViewModel
<link rel="stylesheet" href="~/css/index.css" />
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pokémon SCISA";
}

<div class="container mt-4">
    <h2 class="text-center display-5 fw-bold mb-4">Pokémon SCISA</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- ============================================ -->
    <!--  Formulario de filtros + botón Exportar abajo -->
    <!-- ============================================ -->
    <div class="row mb-4 justify-content-center">
        <div class="col-12 col-md-6">
            <!-- 1) Filtros -->
            <form method="get" asp-action="Index" class="row gx-2 gy-2">
                <div class="col-12 col-sm-6">
                    <label for="nameFilter" class="form-label">Filtrar por Nombre:</label>
                    <input type="text"
                           name="nameFilter"
                           id="nameFilter"
                           value="@Model.NameFilter"
                           class="form-control"
                           placeholder="Ej. pikachu" />
                </div>
                <div class="col-12 col-sm-6">
                    <label for="typeFilter" class="form-label">Filtrar por Tipo:</label>
                    <select name="typeFilter"
                            id="typeFilter"
                            class="form-select">
                        <option value="">-- Todos --</option>
                        @foreach (var type in Model.TypeOptions)
                        {
                            <option value="@type"
                                    selected="@(type == Model.SelectedType ? "selected" : null)">
                                @type
                            </option>
                        }
                    </select>
                </div>
                <div class="col-12 mt-2 d-grid">
                    <button type="submit" class="btn btn-primary w-100">Aplicar</button>
                </div>
            </form>

            <!-- 2) Botón Exportar a Excel, siempre debajo de "Aplicar" -->
            <div class="mt-3 d-grid">
                <form asp-controller="Pokemon"
                      asp-action="ExportToExcel"
                      method="post"
                      id="exportForm">
                    <input type="hidden" name="excelRows" id="excelRowsJson" />
                    <button type="button" class="btn btn-success w-100" id="exportExcelBtn">
                        Exportar a Excel
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- =============================== -->
    <!--   Tabla de Pokémon con botones  -->
    <!-- =============================== -->
    <div class="table-responsive">
        <table class="table table-striped pokemon-table">
            <thead class="table-primary">
                <tr>
                    <th scope="col">Imagen</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Pokemons)
                {
                    <tr>
                        <td class="align-middle">
                            <img src="@p.ImageUrl"
                                 alt="@p.Name"
                                 width="64"
                                 height="64"
                                 class="pokemon-img rounded" />
                        </td>
                        <td class="text-capitalize align-middle">@p.Name</td>
                        <td class="text-capitalize align-middle">@string.Join(", ", p.Types)</td>
                        <td class="align-middle">
                            <!-- Aquí se envuelven los dos botones en un flex responsivo -->
                            <div class="d-flex flex-column flex-md-row gap-1">
                                <button type="button"
                                        class="btn btn-primary btn-sm w-20 w-md-auto"
                                        onclick="showDetail(@p.Id)">
                                    Detalle
                                </button>
                                <button type="button"
                                        class="btn btn-secondary btn-sm w-20 w-md-auto"
                                        onclick="openBulkEmailModal('@p.Name')">
                                    Enviar Correo
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@Html.Partial("_PaginationPartial", Model)
@Html.Partial("_DetailModalPartial")
@Html.Partial("_BulkEmailModalPartial")
