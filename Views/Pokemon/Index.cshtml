@model MiPokemonApp.Models.ViewModels.PokemonFilterViewModel
<link rel="stylesheet" href="~/css/pokemon-list.css" />

@{
    ViewData["Title"] = "Listado de Pokémon";
}


<h2 class="pokemon-list-title">Listado de Pokémon</h2>

<!-- Mensajes de éxito o error -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<!--
    Toolbar: aquí se agrupan
    - los filtros + “Exportar a Excel” (izquierda)
    - el botón “Enviar Correo a Todos” (derecha)
-->
<div class="toolbar">
    <!-- Bloque izquierdo: filtros + Exportar a Excel -->
    <div class="toolbar-left">
        <!-- FORMULARIO DE FILTROS -->
        <form method="get" asp-action="Index" class="pokemon-filter-form">
            <div class="filter-field">
                <label for="nameFilter">Filtrar por Nombre:</label>
                <input type="text"
                       name="nameFilter"
                       value="@Model.NameFilter"
                       class="form-control"
                       placeholder="Ej. pikachu" />
            </div>

            <div class="filter-field">
                <label for="speciesFilter">Filtrar por Especie:</label>
                <select name="speciesFilter" class="form-select">
                    <option value="">-- Todos --</option>
                    @foreach (var sp in Model.SpeciesOptions)
                    {
                        <option value="@sp" @(sp == Model.SelectedSpecies ? "selected" : "")>
                            @sp
                        </option>
                    }
                </select>
            </div>

            <div class="filter-field">
                <button type="submit" class="btn-primary">Aplicar</button>
            </div>
        </form>

        <!-- FORMULARIO DE “Exportar a Excel” -->
        <form method="post"
              action="@Url.Action("ExportToExcel", "Pokemon")"
              id="exportForm"
              class="pokemon-export-form">
            <input type="hidden" name="excelRows" id="excelRowsJson" />
            <button type="button" class="btn-success" id="exportExcelBtn">
                Exportar a Excel
            </button>
        </form>


    </div>

    <!-- Botón “Enviar Correo a Todos” (derecha) -->
    <button class="btn-send-all" data-bs-toggle="modal" data-bs-target="#bulkEmailModal">
        Enviar Correo a Todos
    </button>
</div>

<!-- ======== TABLA DE POKÉMON ======== -->
<table class="table table-striped pokemon-table">
    <thead>
        <tr>
            <th>Imagen</th>
            <th>Nombre</th>
            <th>Especie</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Pokemons)
        {
            <tr>
                <td>
                    <img src="@p.ImageUrl" alt="@p.Name" width="64" height="64" class="pokemon-img" />
                </td>
                <td class="text-capitalize">@p.Name</td>
                <td class="text-capitalize">@p.SpeciesName</td>
                <td>
                    <button class="btn-action detail-btn" onclick="showDetail(@p.Id)">
                        Detalle
                    </button>
                    <button class="btn-action email-btn" data-bs-toggle="modal" data-bs-target="#emailModal">
                        Enviar Correo
                    </button>
                </td>
            </tr>

        }
    </tbody>
</table>

<nav aria-label="Paginación">
    <ul class="custom-pagination">
        @{
            int totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
            int currentPage = Model.PageNumber;
            int maxPagesToShow = 5;

            int startPage = Math.Max(1, currentPage - maxPagesToShow / 2);
            int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

            if (endPage - startPage + 1 < maxPagesToShow)
            {
                startPage = Math.Max(1, endPage - maxPagesToShow + 1);
            }

            // Botón "Primero"
            if (currentPage > 1)
            {
                <li><a href="@Url.Action("Index", new { nameFilter = Model.NameFilter, speciesFilter = Model.SelectedSpecies, page = 1 })">« Primero</a></li>
                <li><a href="@Url.Action("Index", new { nameFilter = Model.NameFilter, speciesFilter = Model.SelectedSpecies, page = currentPage - 1 })">‹ Anterior</a></li>
            }

            // Páginas del medio
            for (int i = startPage; i <= endPage; i++)
            {
                if (i == currentPage)
                {
                    <li class="active"><span>@i</span></li>
                }
                else
                {
                    <li><a href="@Url.Action("Index", new { nameFilter = Model.NameFilter, speciesFilter = Model.SelectedSpecies, page = i })">@i</a></li>
                }
            }

            // Botón "Siguiente" y "Último"
            if (currentPage < totalPages)
            {
                <li><a href="@Url.Action("Index", new { nameFilter = Model.NameFilter, speciesFilter = Model.SelectedSpecies, page = currentPage + 1 })">Siguiente ›</a></li>
                <li><a href="@Url.Action("Index", new { nameFilter = Model.NameFilter, speciesFilter = Model.SelectedSpecies, page = totalPages })">Último »</a></li>
            }
        }
    </ul>
</nav>


<!-- ======== MODAL DETALLE ======== -->
<div id="detailModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header">
            <h5>Detalle de Pokémon</h5>
            <button onclick="closeDetailModal()" class="modal-close-btn">&times;</button>
        </div>
        <div id="detailModalBody" class="modal-body">
            <!-- Aquí se inyecta el detalle vía JS -->
        </div>
    </div>
</div>


<!-- ======== MODAL CORREO INDIVIDUAL ======== -->
<div class="modal fade" id="emailModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-action="SendEmail" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Enviar Correo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="subject" value="Información de Pokémon" />
                <input type="hidden" name="body" value="¡Hola! Aquí tienes información sobre tu Pokémon favorito." />
                <div class="mb-3">
                    <label for="emailTo" class="form-label">Correo destino:</label>
                    <input type="email" class="form-control" name="emailTo" id="emailTo" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Enviar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </form>
    </div>
</div>

<!-- ======== MODAL CORREO MASIVO ======== -->
<div class="modal fade" id="bulkEmailModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="post" asp-action="SendBulkEmail" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Enviar Correo Masivo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="emailList" class="form-label">Correos (separados por coma):</label>
                    <textarea class="form-control"
                              name="emailList"
                              id="emailList"
                              rows="3"
                              placeholder="a@ejemplo.com, b@ejemplo.com"
                              required></textarea>
                </div>
                <input type="hidden" name="subject" value="Pokémon Destacados" />
                <input type="hidden" name="body" value="¡Conoce los Pokémon más geniales de la semana!" />
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Enviar Masivo</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </form>
    </div>
</div>
<script src="~/js/pokemon-list.js"></script>