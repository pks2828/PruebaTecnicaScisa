@model MiPokemonApp.Models.ViewModels.PokemonFilterViewModel
<link rel="stylesheet" href="~/css/index.css" />
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pokémon SCISA";
}

<div class="container mt-4">
    <!-- Título de la página -->
    <h2 class="text-center display-5 fw-bold mb-4">Pokémon SCISA</h2>

    <!-- Alertas de éxito / error -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- ================================================================= -->
    <!-- Aquí va UN SOLO FORM para los filtros (nameFilter + typeFilter) -->
    <!-- ================================================================= -->
    <div class="row align-items-end mb-4">
        <!-- Formulario de filtros y botón Excel en una sola fila -->
        <form method="get" asp-action="Index" class="col-md-5 row gx-2 gy-2">
            <!-- Filtrar por Nombre -->
            <div class="col-sm-12 col-md-6">
                <label for="nameFilter" class="form-label">Filtrar por Nombre:</label>
                <input type="text"
                       name="nameFilter"
                       id="nameFilter"
                       value="@Model.NameFilter"
                       class="form-control"
                       placeholder="Ej. pikachu" />
            </div>

            <!-- Filtrar por Tipo -->
            <div class="col-sm-12 col-md-6">
                <label for="typeFilter" class="form-label">Filtrar por Tipo:</label>
                <select name="typeFilter"
                        id="typeFilter"
                        class="form-select">
                    <option value="">-- Todos --</option>
                    @foreach (var type in Model.TypeOptions)
                    {
                        <option value="@type"
                                selected="@(type == Model.SelectedType ? "selected" : null)">
                            @type
                        </option>
                    }
                </select>
            </div>

            <!-- Botón Aplicar -->
            <div class="col-12 mt-2 d-grid">
                <button type="submit" class="btn btn-primary w-100">Aplicar</button>
            </div>
        </form>

        <!-- Botón Exportar Excel -->
        <div class="col-md-2 offset-md-1 d-grid">
            <form asp-controller="Pokemon" asp-action="ExportToExcel" method="post" id="exportForm">
                <input type="hidden" name="excelRows" id="excelRowsJson" />
                <button type="button" class="btn btn-success" id="exportExcelBtn">
                    Exportar a Excel
                </button>
            </form>
        </div>
    </div>

    <!-- Tabla de Pokémon (igual que antes) -->
    <div class="table-responsive">
        <table class="table table-striped pokemon-table">
            <thead class="table-primary">
                <tr>
                    <th scope="col">Imagen</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Especie</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Pokemons)
                {
                    <tr>
                        <td class="align-middle">
                            <img src="@p.ImageUrl"
                                 alt="@p.Name"
                                 width="64"
                                 height="64"
                                 class="pokemon-img rounded" />
                        </td>
                        <td class="text-capitalize align-middle">@p.Name</td>
                        <td class="text-capitalize align-middle">@string.Join(", ", p.Types)</td>
                        <td class="align-middle">
                            <button type="button"
                                    class="btn btn-primary btn-sm me-1"
                                    onclick="showDetail(@p.Id)">
                                Detalle
                            </button>
                            <button type="button"
                                    class="btn btn-secondary btn-sm"
                                    onclick="openBulkEmailModal()">
                                Enviar Correo
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Partials de paginación / modales -->
@Html.Partial("_PaginationPartial", Model)
@Html.Partial("_DetailModalPartial")
@Html.Partial("_BulkEmailModalPartial")