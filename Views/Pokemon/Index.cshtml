@model MiPokemonApp.Models.ViewModels.PokemonFilterViewModel
<link rel="stylesheet" href="~/css/index.css" />
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Listado de Pokémon";
}

<div class="container mt-4">
    <!-- Título de la página -->
    <h2 class="text-center display-5 fw-bold mb-4">Listado de Pokémon</h2>

    <!-- Alertas de éxito / error -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Sección de filtros y botón de exportar -->
    <div class="row align-items-center mb-4">
        <!-- Filtros de nombre y especie -->
        <div class="col-md-8">
            <form method="get" asp-action="Index" class="row gx-2 gy-2 align-items-end">
                <div class="col-sm-5 col-md-5">
                    <label for="nameFilter" class="form-label">Filtrar por Nombre:</label>
                    <input type="text" name="nameFilter" id="nameFilter" value="@Model.NameFilter" class="form-control" placeholder="Ej. pikachu" />
                </div>
                <div class="col-sm-4 col-md-4">
                    <label for="speciesFilter" class="form-label">Filtrar por Especie:</label>
                    <select name="speciesFilter" id="speciesFilter" class="form-select">
                        <option value="">-- Todos --</option>
                        @foreach (var sp in Model.SpeciesOptions)
                        {
                            <option value="@sp" selected="@(sp == Model.SelectedSpecies ? "selected" : null)">@sp</option>
                        }
                    </select>
                </div>
                <div class="col-sm-3 col-md-3 d-grid">
                    <button type="submit" class="btn btn-primary">Aplicar</button>
                </div>
            </form>
        </div>

        <!-- Botón para exportar a Excel -->
        <div class="col-md-4 d-flex justify-content-md-end mt-3 mt-md-0">
            <form asp-controller="Pokemon" asp-action="ExportToExcel" method="post" id="exportForm" class="d-flex">
                <input type="hidden" name="excelRows" id="excelRowsJson" />
                <button type="button" class="btn btn-success me-2" id="exportExcelBtn">Exportar a Excel</button>
            </form>
        </div>
    </div>

    <!-- Tabla de Pokémon -->
    <div class="table-responsive">
        <table class="table table-striped pokemon-table">
            <thead class="table-light">
                <tr>
                    <th scope="col">Imagen</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Especie</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Pokemons)
                {
                    <tr>
                        <td class="align-middle">
                            <img src="@p.ImageUrl" alt="@p.Name" width="64" height="64" class="pokemon-img rounded" />
                        </td>
                        <td class="text-capitalize align-middle">@p.Name</td>
                        <td class="text-capitalize align-middle">@p.SpeciesName</td>
                        <td class="align-middle">
                            <!-- Botones de detalle y envío de correo -->
                            <button type="button" class="btn btn-outline-primary btn-sm me-1" onclick="showDetail(@p.Id)">Detalle</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="openBulkEmailModal()">Enviar Correo</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Partial: Paginación -->
    @Html.Partial("_PaginationPartial", Model)

    <!-- Partial: Modal de detalle -->
    @Html.Partial("_DetailModalPartial")

    <!-- Partial: Modal de envío de correo masivo -->
    @Html.Partial("_BulkEmailModalPartial")

<script src="~/js/index.js"></script>
